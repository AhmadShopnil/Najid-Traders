# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGODB_DB_NAME=najid_traders_cms

# Authentication (generate strong 32+ char secret for production)
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXTAUTH_URL=https://your-domain.com

# Initial Super Admin Bootstrap (used automatically if no super_admin exists in DB)
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=test@example.com
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword!123

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
